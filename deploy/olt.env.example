# Open Layout Tool — server configuration.
#
# Copy to /etc/open-layout-tool/olt.env (or anywhere, and hand it to the scripts
# with --config <file>), adjust, then run deploy/setup.sh once and
# deploy/deploy.sh after every update. Every variable has a default; only
# OLT_DOMAIN must be set.

# Public host name. Caddy fetches the TLS certificate for it (Let's Encrypt),
# so DNS must point here before setup runs.
OLT_DOMAIN=online.example.org

# A second instance on the same machine (e.g. production beside a test
# server): its name goes into the units (olt-<name>-server …), the default user
# (olt-<name>) and data directory (/var/lib/open-layout-tool-<name>). Give it
# its own ports below. Empty: the plain names olt-server, olt, …
#OLT_INSTANCE=

# What deploy.sh may put on this instance:
#   main  git pull of the branch (--pull), every commit — a test server
#   tags  only prod-* tags with a green CI (--ref <tag>, see release.sh)
#OLT_TRACK=main

# The checkout this file belongs to. Default: the repository the scripts live in.
#OLT_REPO=/opt/open-layout-tool

# System user the services run as. setup.sh creates it if missing; a checkout
# under a closed directory such as /root gets it through with an ACL.
#OLT_USER=olt

# Everything the services write: database, backups, venv, terrain cache, NTv2
# grids for PROJ. Owned by OLT_USER.
#OLT_DATA=/var/lib/open-layout-tool
#OLT_DB=$OLT_DATA/olt.sqlite
#OLT_BACKUPS=$OLT_DATA/backups
#OLT_BACKUP_DAYS=30
#OLT_VENV=$OLT_DATA/venv
#OLT_TERRAIN_CACHE=$OLT_DATA/terrain-cache
# Point clouds (phase 13): uploads and tiles, some 15 GB a project of 5 km with
# colour, 25 GB at most a project. Not in the daily backup.
#OLT_CLOUDS=$OLT_DATA/clouds

# Where the services listen. Never 0.0.0.0 — neither service is meant to be
# reachable except through Caddy.
#OLT_BIND=127.0.0.1
#OLT_SERVER_PORT=8787
#OLT_OPTIMIZER_PORT=8099
# Log level of the project server (fatal, error, warn, info, debug).
#OLT_SERVER_LOG=info

# Caddy:
#   system    install Caddy from its apt repository, write the site to
#             /etc/caddy/conf.d/open-layout-tool.caddy (default)
#   external  a Caddy that is already running elsewhere (e.g. in a container):
#             the site block is only written to OLT_CADDY_DIR, which that
#             Caddy imports (a directory mount sees new files at once)
#OLT_CADDY=system
# Where the site block goes (open-layout-tool[-<instance>].caddy).
# Default: /etc/caddy/conf.d (system), $OLT_DATA (external).
#OLT_CADDY_DIR=/etc/open-layout-tool/caddy
# external: command that makes the running Caddy read it, run by setup.sh.
#OLT_CADDY_RELOAD="docker exec osrd-caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile"
# How Caddy reaches the services and the built app. With OLT_CADDY=system the
# defaults fit; a containerised Caddy sees other addresses and paths.
#OLT_UPSTREAM=$OLT_BIND
#OLT_SITE_ROOT=$OLT_REPO/dist
# Addresses (or CIDR ranges) Caddy's requests come from; only their
# X-Forwarded-For is believed (the login brake counts per client address).
# A Caddy in a container: its network, e.g. 172.18.0.0/16.
#OLT_TRUST_PROXY=127.0.0.1,::1

# First admin, created by setup.sh when the database has no user yet. The start
# password is generated and written to $OLT_DATA/admin-start-password.txt.
#OLT_ADMIN_LOGIN=admin

# Optimizer service limits (see tools/optimizer/olt_optimizer/service.py).
#OLT_OPTIMIZER_TIMEOUT=120
#OLT_OPTIMIZER_WORKERS=2

# Point cloud jobs: preparations and long runs at once (each in its own
# process), and the memory all of them may take together.
#OLT_CLOUDJOBS_PARALLEL=2
#OLT_CLOUDRUNS_PARALLEL=2
#OLT_CLOUDJOBS_MEMORY=3G
# Memory limits of the other two services (systemd MemoryMax).
#OLT_SERVER_MEMORY=infinity
#OLT_OPTIMIZER_MEMORY=infinity

# Built into the app: an instance's own MapTiler key (satellite, terrain).
#VITE_MAPTILER_KEY=
