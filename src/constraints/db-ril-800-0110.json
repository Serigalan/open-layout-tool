  "derived_inputs": [
    { "key": "u0_factor", "provider": "physics", "unit": "mm·m/(km/h)²", "definition": "Faktor der ausgleichenden Überhöhung (11,8 bei Normalspur)" },
    { "key": "u_0", "provider": "physics", "unit": "mm", "definition": "ausgleichende Überhöhung aus v und r" },
    { "key": "u_f", "provider": "physics", "unit": "mm", "definition": "u_0 − u" },
    { "key": "delta_u", "provider": "physics", "unit": "mm", "definition": "|u am Ende − u am Anfang| des Übergangsbogens" },
    { "key": "delta_u_f", "provider": "physics", "unit": "mm", "definition": "|u_f am Ende − u_f am Anfang| des Übergangsbogens, gerechnet mit dem v des Übergangsbogens" },
    { "key": "ramp_slope", "provider": "physics", "unit": "-", "definition": "Nenner der mittleren Rampenneigung: m bzw. m_M = 1000 · l / Δu (l in m, Δu in mm)" },
    {
      "key": "r_w",
      "provider": "physics",
      "unit": "m",
      "definition": "Vergleichsradius an einem Krümmungssprung: 1/r_w = |κ_1 − κ_2| mit vorzeichenbehafteter Krümmung κ = ±1/r. Gerade an Bogen: r_w = r; gleichgerichtete Bögen: r_1·r_2/|r_1 − r_2|; Gegenbögen: r_1·r_2/(r_1 + r_2)."
    },
    { "key": "curvature_jump", "provider": "physics", "unit": "bool", "definition": "Krümmung ist an der Elementgrenze unstetig" },
    { "key": "reverse_curve_straight", "provider": "model", "unit": "bool", "definition": "Gerade, deren beide Nachbarelemente gekrümmt sind und entgegengesetzte Krümmungsrichtung haben" },
    { "key": "ramp_on_transition", "provider": "model", "unit": "bool", "definition": "Die Überhöhungsrampe beginnt und endet genau mit einem Übergangsbogen" },
    { "key": "ramp_form_matches", "provider": "model", "unit": "bool", "definition": "Rampenform passt zur Übergangsbogenform: gerade Rampe zu Klothoide, geschwungene Rampe zu Blossbogen" },
    { "key": "gradient", "provider": "physics", "unit": "‰", "definition": "Betrag der Längsneigung eines Neigungsabschnitts: 1000 · |z_2 − z_1| / (s_2 − s_1) zwischen zwei aufeinanderfolgenden Höhenpunkten der Gradiente (Tangentenpolygon), auf 0,01 ‰ gerundet" },
    { "key": "tunnel_length", "provider": "model", "unit": "m", "definition": "Länge des Tunnels, in dem der Neigungsabschnitt liegt" },
    { "key": "gradient_change", "provider": "physics", "unit": "‰", "definition": "Neigungsdifferenz Δs = |s_2 − s_1| der beiden vorzeichenbehafteten Neigungen an einem Höhenpunkt, auf 0,01 ‰ gerundet" },
    { "key": "vertical_curve_length", "provider": "physics", "unit": "m", "definition": "Länge des Ausrundungsbogens l_a = r_a · Δs / 1000 (zweimal die Tangentenlänge), auf 0,01 m gerundet; 0 ohne Ausrundung" },
    { "key": "crest", "provider": "model", "unit": "bool", "definition": "Der Neigungswechsel ist eine Kuppe (die Neigung nimmt in Stationierungsrichtung ab); sonst eine Wanne" },
    { "key": "vertical_curve_fits", "provider": "model", "unit": "bool", "definition": "Die Ausrundung liegt ganz zwischen den beiden Nachbarpunkten und überschneidet sich mit keiner anderen" }
  ],

