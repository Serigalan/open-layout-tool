          "from": "element.length",
          "unit": "m",
          "symbol_by_type": { "straight": "l_g", "circular_arc": "l_b", "transition_curve": "l_U bzw. l_UB" }
        }
      },
      "thresholds": {
        "l_min": { "expr": "lookup('min_element_length', v)", "unit": "m" }
      },
      "evaluation": [
        { "if": "l >= l_min", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": "S. 7, Abs. 6 (2)" },
      "status": "confirmed"
    },
    {
      "id": "LP.EL.02",
      "title": "Zwischengerade zwischen Gegenbögen bei 40 km/h",
      "applies_to": { "scope": "element", "element_types": ["straight"] },
      "inputs": {
        "v": { "expr": "max(prev.design_speed, element.design_speed, next.design_speed)", "unit": "km/h" },
        "l_g": { "from": "element.length", "unit": "m" },
        "reverse": { "from": "model.reverse_curve_straight", "unit": "bool" }
      },
      "condition": "reverse and v == 40",
      "thresholds": {
        "l_min": { "expr": "7.2", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_g >= l_min", "severity": "ok" },
        { "else": "error" }
      ],
      "notes": ["Gilt nur bei genau 40 km/h. Für gleichgerichtete Bögen gilt LP.EL.01 (4 m)."],
      "source": { "ref": "RIL_800_0110", "section": "S. 7, Abs. 6 (2)" },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.01",
      "title": "Zulässige Überhöhung",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "u": { "from": "element.cant", "unit": "mm" }
      },
      "thresholds": {
        "max": { "expr": "160", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u <= max", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.02",
      "title": "Zulässiger Überhöhungsfehlbetrag",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "u_f": { "from": "physics.u_f", "unit": "mm" }
      },
      "thresholds": {
        "reg": { "expr": "130", "unit": "mm" },
        "discretion": { "expr": "if(v > 150, 150, 130)", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u_f <= reg", "severity": "ok" },
        { "if": "u_f <= discretion", "severity": "warning" },
        { "else": "error" }
      ],
      "notes": [
        "Ersetzt die bisherige Mindestradius-Tabelle; R_min ist daraus ableitbar.",
        "Der Regelwert ist bei jeder Geschwindigkeit 130 mm. Über 150 km/h dürfen im Ermessen bis zu 150 mm ausgeschöpft werden; bis 150 km/h fallen Regelwert und Ermessensgrenze zusammen, die Warnstufe bleibt dort also leer."
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.03",
      "title": "Überhöhung in 5-mm-Stufen",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "u": { "from": "element.cant", "unit": "mm" }
      },
      "thresholds": {
        "step": { "expr": "5", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u >= 0 and u % step == 0", "severity": "ok" },
        { "else": "error" }
      ],
      "notes": ["u >= 0: negative Überhöhung wird nicht behandelt."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.04",
      "title": "Abweichung von der Regelüberhöhung",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "r": { "from": "element.radius", "unit": "m" },
        "u": { "from": "element.cant", "unit": "mm" }
      },
      "thresholds": {
        "u_reg": { "expr": "min(round_to(6.5 * v^2 / r, 5), if(in_context('switch_area'), 100, 160))", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u == u_reg", "severity": "ok" },
        { "else": "hint" }
      ],
      "notes": ["u ist frei wählbar; die Regel meldet nur die Abweichung von u_reg. u_reg wird auf den jeweiligen Regelwert der Überhöhung begrenzt."],
      "source": { "ref": "RIL_800_0110", "section": "S. 10, Abs. 7 (4)" },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.05",
      "title": "Überhöhung im Weichenbereich",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "u": { "from": "element.cant", "unit": "mm" }
      },
      "condition": "in_context('switch_area')",
      "thresholds": {
        "reg": { "expr": "100", "unit": "mm" },
        "discretion": { "expr": "120", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u <= reg", "severity": "ok" },
        { "if": "u <= discretion", "severity": "warning" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.06",
      "title": "Überhöhungsfehlbetrag im Weichenbereich",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "u_f": { "from": "physics.u_f", "unit": "mm" }
      },
      "condition": "in_context('switch_area')",
      "thresholds": {
        "max": { "expr": "110", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u_f <= max", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.01",
      "title": "Stetiger Überhöhungsverlauf",
      "applies_to": { "scope": "boundary" },
      "inputs": {
        "u_prev": { "from": "prev.cant_end", "unit": "mm" },
        "u_next": { "from": "next.cant_start", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u_prev == u_next", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.02",
      "title": "Überhöhungsrampe deckungsgleich mit Übergangsbogen",
      "applies_to": { "scope": "cant_ramp" },
      "inputs": {
        "on_transition": { "from": "model.ramp_on_transition", "unit": "bool" },
        "form_ok": { "from": "model.ramp_form_matches", "unit": "bool" }
      },
      "evaluation": [
        { "if": "on_transition and form_ok", "severity": "ok" },
        { "else": "special_case" }
      ],
      "notes": ["Jede Überhöhungsänderung außerhalb eines Übergangsbogens oder mit abweichender Länge oder Form ist ein Sonderfall."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.03",
      "title": "Mindestlänge gerade Überhöhungsrampe (Klothoide)",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["clothoid"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "delta_u": { "from": "physics.delta_u", "unit": "mm" },
        "l_R": { "from": "element.length", "unit": "m" }
      },
      "condition": "delta_u > 0",
      "thresholds": {
        "reg": { "expr": "10 * v * delta_u / 1000", "unit": "m" },
        "discretion": { "expr": "8 * v * delta_u / 1000", "unit": "m" },
        "approval": { "expr": "6 * v * delta_u / 1000", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_R >= reg", "severity": "ok" },
        { "if": "l_R >= discretion", "severity": "warning" },
        { "if": "l_R >= approval", "severity": "approval" },
        { "else": "error" }
      ],
      "notes": ["Entspricht einer mittleren Neigung 1:m mit m = 10·v (Regelwert), 8·v (Ermessensgrenze), 6·v (Zustimmungswert)."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.04",
      "title": "Mindestlänge geschwungene Überhöhungsrampe (Blossbogen)",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["bloss"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "delta_u": { "from": "physics.delta_u", "unit": "mm" },
        "l_RB": { "from": "element.length", "unit": "m" }
      },
      "condition": "delta_u > 0",
      "thresholds": {
        "reg": { "expr": "8 * v * delta_u / 1000", "unit": "m" },
        "discretion": { "expr": "6 * v * delta_u / 1000", "unit": "m" },
        "approval": { "expr": "5.5 * v * delta_u / 1000", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_RB >= reg", "severity": "ok" },
        { "if": "l_RB >= discretion", "severity": "warning" },
        { "if": "l_RB >= approval", "severity": "approval" },
        { "else": "error" }
      ],
      "notes": ["Entspricht einer mittleren Neigung 1:m_M mit m_M = 8·v (Regelwert), 6·v (Ermessensgrenze), 5,5·v (Zustimmungswert)."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.05",
      "title": "Mindestlänge Klothoide aus Änderung des Überhöhungsfehlbetrags",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["clothoid"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "delta_u_f": { "from": "physics.delta_u_f", "unit": "mm" },
        "l_U": { "from": "element.length", "unit": "m" }
      },
      "condition": "delta_u_f > 0",
      "thresholds": {
        "reg": { "expr": "4 * v * delta_u_f / 1000", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_U >= reg", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.06",
      "title": "Mindestlänge Blossbogen aus Änderung des Überhöhungsfehlbetrags",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["bloss"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "delta_u_f": { "from": "physics.delta_u_f", "unit": "mm" },
        "l_UB": { "from": "element.length", "unit": "m" }
      },
      "condition": "delta_u_f > 0",
      "thresholds": {
        "reg": { "expr": "4.5 * v * delta_u_f / 1000", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_UB >= reg", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.07",
      "title": "Steilste mittlere Rampenneigung",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["clothoid", "bloss"] },
      "inputs": {
        "delta_u": { "from": "physics.delta_u", "unit": "mm" },
        "m": { "from": "physics.ramp_slope", "unit": "-", "symbol_by_form": { "clothoid": "m", "bloss": "m_M" } }
      },
      "condition": "delta_u > 0",
      "thresholds": {
        "reg": { "expr": "600", "unit": "-" },
        "discretion": { "expr": "400", "unit": "-" }
      },
      "evaluation": [
        { "if": "m >= reg", "severity": "ok" },
        { "if": "m >= discretion", "severity": "warning" },
        { "else": "error" }
      ],
      "notes": ["Maßgebend ist die mittlere Neigung."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.08",
      "title": "Flachste mittlere Rampenneigung",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["clothoid", "bloss"] },
      "inputs": {
        "delta_u": { "from": "physics.delta_u", "unit": "mm" },
        "m": { "from": "physics.ramp_slope", "unit": "-", "symbol_by_form": { "clothoid": "m", "bloss": "m_M" } }
      },
      "condition": "delta_u > 0",
      "thresholds": {
        "max": { "expr": "3000", "unit": "-" }
      },
      "evaluation": [
        { "if": "m <= max", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.09",
      "title": "Klothoide als Standardform",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"] },
      "inputs": {
        "form": { "from": "element.transition_form", "unit": "enum" }
      },
      "evaluation": [
        { "if": "form == 'clothoid'", "severity": "ok" },
        { "else": "hint" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KS.01",
      "title": "Vergleichsradius bei Krümmungssprung",
      "applies_to": { "scope": "boundary", "excludes": ["switch_internal"] },
      "inputs": {
        "jump": { "from": "physics.curvature_jump", "unit": "bool" },
        "v": { "expr": "max(prev.design_speed, next.design_speed)", "unit": "km/h" },
        "r_w": { "from": "physics.r_w", "unit": "m" }
      },
      "condition": "jump",
      "thresholds": {
        "reg": { "expr": "lookup('comparison_radius', v, 'reg')", "unit": "m" },
        "discretion": { "expr": "lookup('comparison_radius', v, 'discretion')", "unit": "m" }
      },
      "evaluation": [
        { "if": "r_w >= reg", "severity": "ok" },
        { "if": "r_w >= discretion", "severity": "warning" },
        { "else": "error" }
      ],
      "notes": ["Über 200 km/h liefert die Tabelle keinen Wert; ein Krümmungssprung ist dann ein Fehler."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KS.02",
      "title": "Krümmungssprung außerhalb des Weichenbereichs",
      "applies_to": { "scope": "boundary", "excludes": ["switch_internal"] },
      "inputs": {
        "jump": { "from": "physics.curvature_jump", "unit": "bool" }
      },
      "condition": "jump and not in_context('switch_area')",
      "evaluation": [
        { "else": "hint" }
      ],
      "notes": ["Außerhalb von Weichenbereichen sollen Übergangsbögen verwendet werden. LP.KS.01 wird unabhängig davon geprüft."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "HP.LN.01",
      "title": "Größte Längsneigung der freien Strecke",
      "applies_to": { "scope": "gradient" },
      "inputs": {
        "s": { "from": "physics.gradient", "unit": "‰" }
      },
      "condition": "in_context('open_line')",
      "thresholds": {
        "max": { "expr": "if(in_context('main_line'), 12.5, 40)", "unit": "‰" }
      },
      "evaluation": [
        { "if": "s <= max", "severity": "ok" },
        { "else": "warning" }
      ],
      "notes": [
        "Hauptbahnen 12,5 ‰, Nebenbahnen und S-Bahnen 40,0 ‰.",
        "„soll nicht überschreiten“: der Wert ist ein Regelwert, eine Überschreitung ist zu begründen."
      ],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10, S. 23" },
      "status": "confirmed"
    },
    {
      "id": "HP.LN.02",
      "title": "Größte Längsneigung in Bahnhofsgleisen mit Halt oder Abstellung",
      "applies_to": { "scope": "gradient" },
      "inputs": {
        "s": { "from": "physics.gradient", "unit": "‰" }
      },
      "condition": "in_context('station_track')",
      "thresholds": {
        "max": { "expr": "2.5", "unit": "‰" }
      },
      "evaluation": [
        { "if": "s <= max", "severity": "ok" },
        { "else": "warning" }
      ],
      "notes": [
        "Gilt für Abschnitte von Bahnhofsgleisen, in denen Züge zum Halten kommen oder Schienenfahrzeuge abgestellt werden können, bei Neubauten. Siehe auch Ril 813.0201.",
        "„soll nicht überschreiten“: der Wert ist ein Regelwert, eine Überschreitung ist zu begründen."
      ],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10, S. 23" },
      "open_point": "OP.11",
      "status": "confirmed"
    },
    {
      "id": "HP.LN.03",
      "title": "Kleinste Längsneigung im Tunnel",
      "applies_to": { "scope": "gradient" },
      "inputs": {
        "s": { "from": "physics.gradient", "unit": "‰" },
        "l_t": { "from": "model.tunnel_length", "unit": "m" }
      },
      "condition": "in_context('tunnel')",
      "thresholds": {
        "min": { "expr": "if(l_t <= 1000, 2, 4)", "unit": "‰" }
      },
      "evaluation": [
        { "if": "s >= min", "severity": "ok" },
        { "else": "warning" }
      ],
      "notes": [
        "Tunnellänge bis 1000 m mindestens 2 ‰, über 1000 m mindestens 4 ‰ (Fußnoten 38 und 39 der Ril).",
        "„soll betragen“: der Wert ist ein Regelwert, eine Unterschreitung ist zu begründen."
      ],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10, S. 23" },
      "open_point": "OP.12",
      "status": "confirmed"
    },
    {
      "id": "HP.AR.01",
      "title": "Ausrundung nach Neigungsdifferenz",
      "applies_to": { "scope": "vertical_curve" },
      "inputs": {
        "ds": { "from": "physics.gradient_change", "unit": "‰" },
        "ra": { "from": "point.vertical_radius", "unit": "m" },
        "ds_free": { "expr": "if(in_context('siding') or in_context('track_connection'), 4.5, 1)", "unit": "‰" }
      },
      "condition": "ds > 0",
      "evaluation": [
        { "if": "ds > ds_free and ra > 0", "severity": "ok" },
        { "if": "ds <= ds_free and ra == 0", "severity": "ok" },
        { "if": "ds > ds_free", "severity": "error" },
        { "else": "hint" }
      ],
      "notes": [
        "Neigungswechsel sind auszurunden. Bei Neigungsdifferenzen ≤ 1 ‰ ist ohne Ausrundung auszubilden, bei Nebengleisen und in Weichenverbindungen bei ≤ 4,5 ‰.",
        "Fehlt die nötige Ausrundung, hat die Gradiente einen Knick (Fehler); eine Ausrundung, wo keine sein soll, ist ein Hinweis."
      ],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10" },
      "status": "confirmed"
    },
    {
      "id": "HP.AR.02",
      "title": "Länge des Ausrundungsbogens",
      "applies_to": { "scope": "vertical_curve" },
      "inputs": {
        "v": { "from": "point.design_speed", "unit": "km/h" },
        "ds": { "from": "physics.gradient_change", "unit": "‰" },
        "ra": { "from": "point.vertical_radius", "unit": "m" },
        "la": { "from": "physics.vertical_curve_length", "unit": "m" }
      },
      "condition": "ds > 0 and ra > 0",
      "thresholds": {
        "reg": { "expr": "20", "unit": "m" },
        "min_connection": { "expr": "10", "unit": "m" },
        "v_connection": { "expr": "80", "unit": "km/h" },
        "ds_connection": { "expr": "4.5", "unit": "‰" },
        "ra_connection": { "expr": "2000", "unit": "m" }
      },
      "evaluation": [
        { "if": "la >= reg", "severity": "ok" },
        { "if": "in_context('track_connection') and v <= v_connection and ds <= ds_connection and la >= min_connection and ra >= ra_connection", "severity": "ok" },
        { "else": "warning" }
      ],
      "notes": [
        "l_a soll mindestens 20 m betragen.",
        "Ist das in Gleisverbindungen nicht möglich, darf bis v ≤ 80 km/h und einer Neigungsdifferenz ≤ 4,5 ‰ mit l_a ≥ 10 m und r_a ≥ 2000 m trassiert werden."
      ],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10" },
      "open_point": "OP.13",
      "status": "confirmed"
    },
    {
      "id": "HP.AR.03",
      "title": "Halbmesser des Ausrundungsbogens",
      "applies_to": { "scope": "vertical_curve" },
      "inputs": {
        "v": { "from": "point.design_speed", "unit": "km/h" },
        "ds": { "from": "physics.gradient_change", "unit": "‰" },
        "ra": { "from": "point.vertical_radius", "unit": "m" },
        "crest": { "from": "model.crest", "unit": "bool" }
      },
      "condition": "ds > 0 and ra > 0",
      "thresholds": {
        "max": { "expr": "25000", "unit": "m" },
        "reg": { "expr": "if(v <= 230, max(0.4 * v^2, 2000), 22500)", "unit": "m" },
        "discretion": { "expr": "if(v <= 230, max(0.25 * v^2, 2000), if(crest, 16000, 14000))", "unit": "m" },
        "approval": { "expr": "if(crest, 0.16, 0.13) * v^2", "unit": "m" }
      },
      "evaluation": [
        { "if": "ra > max", "severity": "error" },
        { "if": "ra >= reg", "severity": "ok" },
        { "if": "ra >= discretion", "severity": "warning" },
        { "if": "ra >= approval", "severity": "approval" },
        { "else": "error" }
      ],
      "notes": [
        "v ≤ 230 km/h: Regelwert 0,4 · v², Ermessensgrenze 0,25 · v² und mindestens 2000 m, Zustimmungswert 0,16 · v² bei Kuppen und 0,13 · v² bei Wannen; unter 2000 m nur mit Zustimmung.",
        "v > 230 km/h: Regelwert 22500 m, Ermessensgrenze 16000 m bei Kuppen und 14000 m bei Wannen, Zustimmungswert wie oben.",
        "Höchstwert in beiden Bereichen 25000 m."
      ],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10, Tabelle 12" },
      "open_point": "OP.13",
      "status": "confirmed"
    },
    {
      "id": "HP.AR.04",
      "title": "Ausrundungen überschneiden sich nicht",
      "applies_to": { "scope": "vertical_curve" },
      "inputs": {
        "ds": { "from": "physics.gradient_change", "unit": "‰" },
        "ra": { "from": "point.vertical_radius", "unit": "m" },
        "fits": { "from": "model.vertical_curve_fits", "unit": "bool" }
      },
      "condition": "ds > 0 and ra > 0",
      "evaluation": [
        { "if": "fits", "severity": "ok" },
        { "else": "error" }
      ],
      "notes": ["Eine Ausrundung, die über einen Nachbarpunkt hinausreicht oder in die nächste hineinläuft, lässt sich nicht bauen."],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10" },
      "status": "confirmed"
    },
    {
      "id": "HP.AR.05",
      "title": "Neigungswechsel in Überhöhungsrampe",
      "applies_to": { "scope": "vertical_curve" },
      "inputs": {
        "v": { "from": "point.design_speed", "unit": "km/h" },
        "ds": { "from": "physics.gradient_change", "unit": "‰" },
        "ra": { "from": "point.vertical_radius", "unit": "m" },
        "ds_free": { "expr": "if(in_context('siding') or in_context('track_connection'), 4.5, 1)", "unit": "‰" }
      },
      "condition": "ds > 0 and in_context('cant_ramp')",
      "thresholds": {
        "reg": { "expr": "if(v <= 230, max(0.4 * v^2, 2000), 22500)", "unit": "m" }
      },
      "evaluation": [
        { "if": "ra >= reg or (ra == 0 and ds <= ds_free)", "severity": "hint" },
        { "else": "warning" }
      ],
      "notes": [
        "Neigungswechsel, auch deren Ausrundungen, sollen in Überhöhungsrampen und in Weichen vermieden werden.",
        "Ist dies nicht möglich, soll r_a nicht kleiner als der Regelwert nach Tabelle 12 sein (wie HP.AR.03).",
        "In Weichen gilt statt dessen HP.AR.06."
      ],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10" },
      "status": "confirmed"
    },
    {
      "id": "HP.AR.06",
      "title": "Neigungswechsel im Weichenbereich (WA bis ldS)",
      "applies_to": { "scope": "vertical_curve" },
      "inputs": {
        "ds": { "from": "physics.gradient_change", "unit": "‰" }
      },
      "condition": "ds > 0 and in_context('switch_body')",
      "evaluation": [
        { "else": "warning" }
      ],
      "notes": [
        "Neigungswechsel, auch deren Ausrundungen, sollen nicht zwischen Weichenanfang und letzter durchgehender Schwelle liegen; die Ril lässt sie in Weichen mit r_a mindestens Regelwert zu (HP.AR.05), das Werkzeug verlangt für jeden eine Begründung.",
        "Bis zur ldS liegen Stamm- und Zweiggleis auf einer Ebene, die Gradiente des Zweiggleises folgt der des Stammgleises (db-ril-800-0120, lds)."
      ],
      "source": { "ref": "RIL_800_0110", "section": "Kap. 10; Festlegung des Auftraggebers vom 2026-10-06" },
      "open_point": "OP.14",
      "status": "confirmed"
    }
  ],

