{
  "catalog": {
    "id": "trassierung-lageplan",
    "title": "Regelkatalog Trassierung – Lageplan",
    "version": "0.2.0",
    "status": "draft",
    "date": "2026-09-22",
    "language": "de",
    "based_on": "Leitfaden Trassierung (Jonathan Wolf)",
    "scope": {
      "included": [
        "Gerade",
        "Kreisbogen und Überhöhung",
        "Übergangsbogen (Klothoide, Blossbogen) mit Überhöhungsrampe",
        "Krümmungssprünge"
      ],
      "excluded": [
        "Weichen einschließlich weicheninterner Krümmungssprünge (eigener Katalog)",
        "Physik und Geometrieberechnung (eigenes Dokument, Schnittstelle siehe derived_inputs)",
        "Höhenplan (folgt, Präfix HP)"
      ]
    },
    "id_scheme": "LP.<Gruppe>.<Nr>. LP = Lageplan, HP = Höhenplan. Gruppen: ALL allgemein, EL Elementlänge, KB Kreisbogen, UB Übergangsbogen und Überhöhungsrampe, KS Krümmungssprung."
  },

  "changelog": [
    {
      "version": "0.2.0",
      "date": "2026-09-22",
      "changes": [
        "Grenzwerte für u und u_f auf DB Ril 800.0110 umgestellt; Verkehrsart und Bahnsteigbereich als Kontexte entfernt",
        "Neue Regeln LP.KB.05 und LP.KB.06 für den Weichenbereich",
        "Kontextkombination durch getrennte Regeln und Aggregation ersetzt",
        "Vergleichsradius: Ermessensgrenze bis 100 km/h zwischen den Tabellenwerten per Formel",
        "Stufe approval, Rampenneigungen, 5-km/h-Raster und Mindestlängen aus Δu_f bestätigt"
      ]
    },
    { "version": "0.1.0", "date": "2026-09-22", "changes": ["Erster Entwurf"] }
  ],

  "sources": [
    {
      "id": "RIL_800_0110",
      "title": "DB Ril 800.0110 Linienführung",
      "version": "3.0",
      "gueltig_ab": "2021-02-01"
    }
  ],

  "severity_levels": [
    { "id": "ok", "rank": 0, "title": "eingehalten" },
    { "id": "hint", "rank": 1, "title": "Hinweis", "meaning": "Empfehlung nicht befolgt" },
    {
      "id": "warning",
      "rank": 2,
      "title": "Warnung",
      "meaning": "Regelwert unterschritten, Ermessensgrenze eingehalten",
      "requires_justification": true
    },
    {
      "id": "approval",
      "rank": 3,
      "title": "Zustimmung erforderlich",
      "meaning": "Ermessensgrenze unterschritten, Zustimmungswert eingehalten",
      "requires_justification": true,
      "requires_approval": true
    },
    {
      "id": "special_case",
      "rank": 4,
      "title": "Sonderfall",
      "meaning": "Nicht durch den Leitfaden abgedeckt; Planung nur durch erfahrene Trassiererinnen und Trassierer"
    },
    { "id": "error", "rank": 5, "title": "Fehler", "meaning": "Grenzwert verletzt oder unzulässig" }
  ],

  "aggregation": "Jede Regel liefert genau eine Stufe. Das Gesamtergebnis eines Objekts ist die angewendete Stufe mit dem höchsten rank. Gelten für ein Objekt mehrere Grenzwerte (etwa allgemein und im Weichenbereich), sind sie als getrennte Regeln formuliert; so setzt sich automatisch der strengste durch.",

  "evaluation_semantics": {
    "order": "Die Einträge in evaluation werden der Reihe nach geprüft; der erste zutreffende bestimmt die Stufe. Ein Eintrag mit else trifft immer zu.",
    "condition": "Ist condition false, wird die Regel nicht angewendet (Ergebnis not_applicable).",
    "out_of_range": "Liefert ein lookup keinen Wert, ergibt die Regel die Stufe aus out_of_range der Tabelle.",
    "neighbours": "prev und next bezeichnen das Nachbarelement vor bzw. hinter dem Objekt in Stationierungsrichtung.",
    "speed": "v ist die design speed des Elements. An Elementgrenzen und bei Regeln über mehrere Elemente gilt der größte Wert der beteiligten Elemente."
  },

  "expression_language": {
    "units": "Alle Ausdrücke sind Zahlenwertgleichungen. Die Einheit jedes Eingangs und Schwellenwerts steht am jeweiligen Eintrag.",
    "operators": ["+", "-", "*", "/", "^", "%", "==", "!=", "<", "<=", ">", ">=", "and", "or", "not"],
    "functions": {
      "min(a, b, ...)": "kleinster Wert",
      "max(a, b, ...)": "größter Wert",
      "abs(x)": "Betrag",
      "if(c, a, b)": "a, wenn c zutrifft, sonst b",
      "round_to(x, step)": "rundet x auf das nächstgelegene Vielfache von step; bei genau halber Stufe wird aufgerundet",
      "lookup(table, key)": "Wert einer Stufentabelle (type piecewise)",
      "lookup(table, key, column)": "Spaltenwert einer Geschwindigkeitstabelle; Zwischenwerte laut key_mode der Tabelle",
      "in_context(id)": "true, wenn sich das Objekt mit dem Kontext id überschneidet"
    }
  },

