    ]
  },

  "derived_inputs": [
    { "key": "u0_factor", "provider": "physics", "unit": "mm·m/(km/h)²", "definition": "Faktor der ausgleichenden Überhöhung (11,8 bei Normalspur)" },
    { "key": "u_0", "provider": "physics", "unit": "mm", "definition": "ausgleichende Überhöhung aus v und r" },
    { "key": "u_f", "provider": "physics", "unit": "mm", "definition": "u_0 − u" },
    { "key": "delta_u", "provider": "physics", "unit": "mm", "definition": "|u am Ende − u am Anfang| des Übergangsbogens" },
    { "key": "delta_u_f", "provider": "physics", "unit": "mm", "definition": "|u_f am Ende − u_f am Anfang| des Übergangsbogens, gerechnet mit dem v des Übergangsbogens" },
    { "key": "ramp_slope", "provider": "physics", "unit": "-", "definition": "Nenner der mittleren Rampenneigung: m bzw. m_M = 1000 · l / Δu (l in m, Δu in mm)" },
    {
      "key": "r_w",
      "provider": "physics",
      "unit": "m",
      "definition": "Vergleichsradius an einem Krümmungssprung: 1/r_w = |κ_1 − κ_2| mit vorzeichenbehafteter Krümmung κ = ±1/r. Gerade an Bogen: r_w = r; gleichgerichtete Bögen: r_1·r_2/|r_1 − r_2|; Gegenbögen: r_1·r_2/(r_1 + r_2)."
    },
    { "key": "curvature_jump", "provider": "physics", "unit": "bool", "definition": "Krümmung ist an der Elementgrenze unstetig" },
    { "key": "reverse_curve_straight", "provider": "model", "unit": "bool", "definition": "Gerade, deren beide Nachbarelemente gekrümmt sind und entgegengesetzte Krümmungsrichtung haben" },
    { "key": "ramp_on_transition", "provider": "model", "unit": "bool", "definition": "Die Überhöhungsrampe beginnt und endet genau mit einem Übergangsbogen" },
    { "key": "ramp_form_matches", "provider": "model", "unit": "bool", "definition": "Rampenform passt zur Übergangsbogenform: gerade Rampe zu Klothoide, geschwungene Rampe zu Blossbogen" }
  ],

  "contexts": {
    "items": [
      { "id": "switch_area", "group": "area", "title": "Weichenbereich", "extent": "Weichenanfang (WA) bis Weichenende (WE)" }
    ],
    "rules": {
      "area": "Ein Objekt liegt in einem Bereich, sobald es sich mit ihm auf einer Länge > 0 überschneidet; eine Elementgrenze, sobald sie im Bereich liegt."
    }
  },

  "element_types": [
    { "id": "straight", "title": "Gerade" },
    { "id": "circular_arc", "title": "Kreisbogen" },
    {
      "id": "transition_curve",
      "title": "Übergangsbogen",
      "forms": [
        { "id": "clothoid", "title": "Klothoide", "ramp_form": "straight_ramp" },
        { "id": "bloss", "title": "Blossbogen", "ramp_form": "curved_ramp" }
      ]
    }
  ],

  "ramp_forms": [
    { "id": "straight_ramp", "title": "gerade Überhöhungsrampe" },
    { "id": "curved_ramp", "title": "geschwungene Überhöhungsrampe (nach Bloss)" }
  ],

  "tables": {
    "min_element_length": {
      "title": "Mindestelementlänge",
      "type": "piecewise",
      "key": "v",
      "key_unit": "km/h",
      "unit": "m",
      "pieces": [
        { "key_min": 40, "key_max": 70, "expr": "0.1 * v" },
        { "key_min_exclusive": 70, "key_max": 100, "expr": "0.15 * v" },
        { "key_min_exclusive": 100, "key_max": 300, "expr": "0.2 * v" }
      ],
      "out_of_range": "error",
      "open_point": "OP.07"
    },
    "comparison_radius": {
      "title": "Mindest-Vergleichsradius bei Krümmungssprüngen",
      "type": "speed_table",
      "key": "v",
      "key_unit": "km/h",
      "unit": "m",
      "columns": {
        "reg": "Regelwert",
        "discretion": "Ermessensgrenze"
      },
      "key_mode": {
        "note": "Tabellierte Geschwindigkeiten verwenden immer den Tabellenwert. key_mode gilt nur für Geschwindigkeiten zwischen zwei Tabellenzeilen.",
        "reg": { "mode": "next_higher" },
        "discretion": {
          "mode": "formula",
          "key_max": 100,
          "expr": "u0_factor * v^2 / 106.5",
          "inputs": { "u0_factor": { "from": "physics.u0_factor" } },
          "rounding": null,
          "above_key_max": "next_higher"
        }
      },
      "out_of_range": "error",
      "open_point": "OP.01",
      "rows": [
        { "v": 40, "reg": 220, "discretion": 178 },
        { "v": 50, "reg": 340, "discretion": 278 },
        { "v": 60, "reg": 490, "discretion": 400 },
        { "v": 70, "reg": 670, "discretion": 545 },
        { "v": 80, "reg": 875, "discretion": 710 },
        { "v": 90, "reg": 1110, "discretion": 900 },
        { "v": 100, "reg": 1370, "discretion": 1110 },
        { "v": 110, "reg": 1735, "discretion": 1410 },
        { "v": 120, "reg": 2170, "discretion": 1745 },
        { "v": 130, "reg": 2680, "discretion": 2130 },
        { "v": 140, "reg": 3275, "discretion": 2575 },
        { "v": 150, "reg": 3990, "discretion": 3085 },
        { "v": 160, "reg": 4825, "discretion": 3675 },
        { "v": 170, "reg": 5810, "discretion": 4350 },
        { "v": 180, "reg": 6975, "discretion": 5125 },
        { "v": 190, "reg": 8365, "discretion": 6000 },
        { "v": 200, "reg": 10000, "discretion": 7000 }
      ]
    }
  },

  "rules": [
    {
      "id": "LP.ALL.01",
      "title": "Geschwindigkeitsbereich der design speed",
      "applies_to": { "scope": "element", "element_types": ["straight", "circular_arc", "transition_curve"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" }
      },
      "evaluation": [
        { "if": "v >= 40 and v <= 300", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.ALL.02",
      "title": "5-km/h-Raster der design speed",
      "applies_to": { "scope": "element", "element_types": ["straight", "circular_arc", "transition_curve"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" }
      },
      "evaluation": [
        { "if": "v % 5 == 0", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.EL.01",
      "title": "Mindestelementlänge",
      "applies_to": { "scope": "element", "element_types": ["straight", "circular_arc", "transition_curve"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "l": {
          "from": "element.length",
          "unit": "m",
          "symbol_by_type": { "straight": "l_g", "circular_arc": "l_b", "transition_curve": "l_U bzw. l_UB" }
        }
      },
      "thresholds": {
        "l_min": { "expr": "lookup('min_element_length', v)", "unit": "m" }
      },
      "evaluation": [
        { "if": "l >= l_min", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "assumption",
      "open_point": "OP.07"
    },
    {
      "id": "LP.EL.02",
      "title": "Zwischengerade zwischen Gegenbögen bei 40 km/h",
      "applies_to": { "scope": "element", "element_types": ["straight"] },
      "inputs": {
        "v": { "expr": "max(prev.design_speed, element.design_speed, next.design_speed)", "unit": "km/h" },
        "l_g": { "from": "element.length", "unit": "m" },
        "reverse": { "from": "model.reverse_curve_straight", "unit": "bool" }
      },
      "condition": "reverse and v == 40",
      "thresholds": {
        "l_min": { "expr": "7.2", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_g >= l_min", "severity": "ok" },
        { "else": "error" }
      ],
      "notes": ["Gilt nur bei genau 40 km/h. Für gleichgerichtete Bögen gilt LP.EL.01 (4 m)."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "assumption",
      "open_point": "OP.07"
    },
    {
      "id": "LP.KB.01",
      "title": "Zulässige Überhöhung",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "u": { "from": "element.cant", "unit": "mm" }
      },
      "thresholds": {
        "max": { "expr": "160", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u <= max", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.02",
      "title": "Zulässiger Überhöhungsfehlbetrag",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "u_f": { "from": "physics.u_f", "unit": "mm" }
      },
      "thresholds": {
        "max": { "expr": "if(v > 150, 150, 130)", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u_f <= max", "severity": "ok" },
        { "else": "error" }
      ],
      "notes": ["Ersetzt die bisherige Mindestradius-Tabelle; R_min ist daraus ableitbar."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "assumption",
      "open_point": "OP.11"
    },
    {
      "id": "LP.KB.03",
      "title": "Überhöhung in 5-mm-Stufen",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "u": { "from": "element.cant", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u >= 0 and u % 5 == 0", "severity": "ok" },
        { "else": "error" }
      ],
      "notes": ["u >= 0: negative Überhöhung wird nicht behandelt."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.04",
      "title": "Abweichung von der Regelüberhöhung",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "r": { "from": "element.radius", "unit": "m" },
        "u": { "from": "element.cant", "unit": "mm" }
      },
      "thresholds": {
        "u_reg": { "expr": "min(round_to(6.5 * v^2 / r, 5), if(in_context('switch_area'), 100, 160))", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u == u_reg", "severity": "ok" },
        { "else": "hint" }
      ],
      "notes": ["u ist frei wählbar; die Regel meldet nur die Abweichung von u_reg. u_reg wird auf den jeweiligen Regelwert der Überhöhung begrenzt."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.05",
      "title": "Überhöhung im Weichenbereich",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "u": { "from": "element.cant", "unit": "mm" }
      },
      "condition": "in_context('switch_area')",
      "thresholds": {
        "reg": { "expr": "100", "unit": "mm" },
        "discretion": { "expr": "120", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u <= reg", "severity": "ok" },
        { "if": "u <= discretion", "severity": "warning" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KB.06",
      "title": "Überhöhungsfehlbetrag im Weichenbereich",
      "applies_to": { "scope": "element", "element_types": ["circular_arc"] },
      "inputs": {
        "u_f": { "from": "physics.u_f", "unit": "mm" }
      },
      "condition": "in_context('switch_area')",
      "thresholds": {
        "max": { "expr": "110", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u_f <= max", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.01",
      "title": "Stetiger Überhöhungsverlauf",
      "applies_to": { "scope": "boundary" },
      "inputs": {
        "u_prev": { "from": "prev.cant_end", "unit": "mm" },
        "u_next": { "from": "next.cant_start", "unit": "mm" }
      },
      "evaluation": [
        { "if": "u_prev == u_next", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.02",
      "title": "Überhöhungsrampe deckungsgleich mit Übergangsbogen",
      "applies_to": { "scope": "cant_ramp" },
      "inputs": {
        "on_transition": { "from": "model.ramp_on_transition", "unit": "bool" },
        "form_ok": { "from": "model.ramp_form_matches", "unit": "bool" }
      },
      "evaluation": [
        { "if": "on_transition and form_ok", "severity": "ok" },
        { "else": "special_case" }
      ],
      "notes": ["Jede Überhöhungsänderung außerhalb eines Übergangsbogens oder mit abweichender Länge oder Form ist ein Sonderfall."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.03",
      "title": "Mindestlänge gerade Überhöhungsrampe (Klothoide)",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["clothoid"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "delta_u": { "from": "physics.delta_u", "unit": "mm" },
        "l_R": { "from": "element.length", "unit": "m" }
      },
      "condition": "delta_u > 0",
      "thresholds": {
        "reg": { "expr": "10 * v * delta_u / 1000", "unit": "m" },
        "discretion": { "expr": "8 * v * delta_u / 1000", "unit": "m" },
        "approval": { "expr": "6 * v * delta_u / 1000", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_R >= reg", "severity": "ok" },
        { "if": "l_R >= discretion", "severity": "warning" },
        { "if": "l_R >= approval", "severity": "approval" },
        { "else": "error" }
      ],
      "notes": ["Entspricht einer mittleren Neigung 1:m mit m = 10·v (Regelwert), 8·v (Ermessensgrenze), 6·v (Zustimmungswert)."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.04",
      "title": "Mindestlänge geschwungene Überhöhungsrampe (Blossbogen)",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["bloss"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "delta_u": { "from": "physics.delta_u", "unit": "mm" },
        "l_RB": { "from": "element.length", "unit": "m" }
      },
      "condition": "delta_u > 0",
      "thresholds": {
        "reg": { "expr": "8 * v * delta_u / 1000", "unit": "m" },
        "discretion": { "expr": "6 * v * delta_u / 1000", "unit": "m" },
        "approval": { "expr": "5.5 * v * delta_u / 1000", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_RB >= reg", "severity": "ok" },
        { "if": "l_RB >= discretion", "severity": "warning" },
        { "if": "l_RB >= approval", "severity": "approval" },
        { "else": "error" }
      ],
      "notes": ["Entspricht einer mittleren Neigung 1:m_M mit m_M = 8·v (Regelwert), 6·v (Ermessensgrenze), 5,5·v (Zustimmungswert)."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.05",
      "title": "Mindestlänge Klothoide aus Änderung des Überhöhungsfehlbetrags",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["clothoid"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "delta_u_f": { "from": "physics.delta_u_f", "unit": "mm" },
        "l_U": { "from": "element.length", "unit": "m" }
      },
      "condition": "delta_u_f > 0",
      "thresholds": {
        "reg": { "expr": "4 * v * delta_u_f / 1000", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_U >= reg", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.06",
      "title": "Mindestlänge Blossbogen aus Änderung des Überhöhungsfehlbetrags",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["bloss"] },
      "inputs": {
        "v": { "from": "element.design_speed", "unit": "km/h" },
        "delta_u_f": { "from": "physics.delta_u_f", "unit": "mm" },
        "l_UB": { "from": "element.length", "unit": "m" }
      },
      "condition": "delta_u_f > 0",
      "thresholds": {
        "reg": { "expr": "4.5 * v * delta_u_f / 1000", "unit": "m" }
      },
      "evaluation": [
        { "if": "l_UB >= reg", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.07",
      "title": "Steilste mittlere Rampenneigung",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["clothoid", "bloss"] },
      "inputs": {
        "delta_u": { "from": "physics.delta_u", "unit": "mm" },
        "m": { "from": "physics.ramp_slope", "unit": "-", "symbol_by_form": { "clothoid": "m", "bloss": "m_M" } }
      },
      "condition": "delta_u > 0",
      "thresholds": {
        "reg": { "expr": "600", "unit": "-" },
        "discretion": { "expr": "400", "unit": "-" }
      },
      "evaluation": [
        { "if": "m >= reg", "severity": "ok" },
        { "if": "m >= discretion", "severity": "warning" },
        { "else": "error" }
      ],
      "notes": ["Maßgebend ist die mittlere Neigung."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.08",
      "title": "Flachste mittlere Rampenneigung",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"], "forms": ["clothoid", "bloss"] },
      "inputs": {
        "delta_u": { "from": "physics.delta_u", "unit": "mm" },
        "m": { "from": "physics.ramp_slope", "unit": "-", "symbol_by_form": { "clothoid": "m", "bloss": "m_M" } }
      },
      "condition": "delta_u > 0",
      "thresholds": {
        "max": { "expr": "3000", "unit": "-" }
      },
      "evaluation": [
        { "if": "m <= max", "severity": "ok" },
        { "else": "error" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.UB.09",
      "title": "Klothoide als Standardform",
      "applies_to": { "scope": "element", "element_types": ["transition_curve"] },
      "inputs": {
        "form": { "from": "element.transition_form", "unit": "enum" }
      },
      "evaluation": [
        { "if": "form == 'clothoid'", "severity": "ok" },
        { "else": "hint" }
      ],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    },
    {
      "id": "LP.KS.01",
      "title": "Vergleichsradius bei Krümmungssprung",
      "applies_to": { "scope": "boundary", "excludes": ["switch_internal"] },
      "inputs": {
        "jump": { "from": "physics.curvature_jump", "unit": "bool" },
        "v": { "expr": "max(prev.design_speed, next.design_speed)", "unit": "km/h" },
        "r_w": { "from": "physics.r_w", "unit": "m" }
      },
      "condition": "jump",
      "thresholds": {
        "reg": { "expr": "lookup('comparison_radius', v, 'reg')", "unit": "m" },
        "discretion": { "expr": "lookup('comparison_radius', v, 'discretion')", "unit": "m" }
      },
      "evaluation": [
        { "if": "r_w >= reg", "severity": "ok" },
        { "if": "r_w >= discretion", "severity": "warning" },
        { "else": "error" }
      ],
      "notes": ["Über 200 km/h liefert die Tabelle keinen Wert; ein Krümmungssprung ist dann ein Fehler."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed",
      "open_point": "OP.01"
    },
    {
      "id": "LP.KS.02",
      "title": "Krümmungssprung außerhalb des Weichenbereichs",
      "applies_to": { "scope": "boundary", "excludes": ["switch_internal"] },
      "inputs": {
        "jump": { "from": "physics.curvature_jump", "unit": "bool" }
      },
      "condition": "jump and not in_context('switch_area')",
      "evaluation": [
        { "else": "hint" }
      ],
      "notes": ["Außerhalb von Weichenbereichen sollen Übergangsbögen verwendet werden. LP.KS.01 wird unabhängig davon geprüft."],
      "source": { "ref": "RIL_800_0110", "section": null },
      "status": "confirmed"
    }
  ],

  "open_points": [
